@unpublished{frings_dataliteracy_2026,
	title = {Preparing data-literate biologists: Examining motivational factors that drive student effort in {R} programming},
	abstract = {Learning programming is essential for developing data literacy in the life sciences. However, students report stress, intimidation, and anxiety when learning R programming in biology courses, which can impact their persistence in learning these skills. This study aimed to use mindset theory and situated expectancy value theory to identify 1) how students’ mindsets and task values changed over a semester, and 2) the extent to which task values mediated the relationship between students’ mindsets and effort. We measured students’ mindsets and task values at two time points (after introduction to R and at the end of the course), alongside students’ self-reported effort at the end of the course. We analyzed the data using multi-level modelling and path analysis. We found students’ growth mindsets, utility value, intrinsic value and emotional costs were variable between students and did not change over a semester, and a slight increase in effort cost. In the mediation model, students’ growth mindsets had a positive affect on their effort when task values were considered. Growth mindsets were positively associated with intrinsic value and utility value, and negatively associated with costs. When accounting for variance between other task values, students with lower growth mindsets put more effort into R programming asks when experiencing higher emotional costs. However, replicated of this model is needed to determine the validity of this relationship. These findings provide evidence of the stability of programming mindsets and values in undergraduate biology courses, and the ability of growth mindset and task values to explain student effort in R tasks.},
	author = {Frings, Faith and Weigel, Emily G. and Aikens, Melissa L.},
pubstate = {in review},
	langid = {english},
	}

